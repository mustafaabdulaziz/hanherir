# Bu dosyayi .env adiyla kopyalayip degerleri doldurun.
# Admin paneli giris sifresi (en az 6 karakter):
ADMIN_PASSWORD=
# Oturum imza anahtari (rastgele uzun bir metin):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Oturum cerezi sadece HTTPS ile gonderilir (canli icin varsayilan).
# Yerelde http://127.0.0.1 ile denerken asagidaki satiri acin:
# COOKIE_SECURE=0
